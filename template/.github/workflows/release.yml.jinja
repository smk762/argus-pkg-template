name: Release to PyPI

# Top-level (non-reusable) on purpose: PyPI trusted publishing cannot run inside
# a reusable workflow. Keep this file in sync across the suite via `copier update`.

on:
  push:
    tags: ["v*"]
  # Sent by argus-cortex's release workflow. The image installs argus-cortex
  # from the pyproject range at build time, so rebuilding the newest release's
  # image is how a new cortex reaches it. Only the image jobs run: PyPI and the
  # GitHub Release for that tag already exist.
  repository_dispatch:
    types: [cortex-released]

permissions:
  contents: read
  id-token: write

jobs:
  build:
    # Not on a cortex dispatch, so the PyPI and Release jobs that chain off it
    # skip too.
    if: github.event_name == 'push'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: astral-sh/setup-uv@v7
        with:
          enable-cache: true
      - run: uv build
      - uses: actions/upload-artifact@v7
        with:
          name: dist
          path: dist/

  test-install:
    runs-on: ubuntu-latest
    needs: build
    strategy:
      matrix:
        # python_min and the next minor, as in ci.yml (tests/test_workflows.py checks
        # every version here satisfies requires-python).
[% set py_minor = python_min.split('.')[1] | int %]        python-version: ["[[ python_min ]]", "3.[[ py_minor + 1 ]]"]
    steps:
      - uses: actions/download-artifact@v8
        with:
          name: dist
          path: dist/
      - uses: astral-sh/setup-uv@v7
        with:
          enable-cache: true
      - name: Install wheel and smoke-test import
        run: |
          uv venv --python ${{ matrix.python-version }}
          uv pip install dist/*.whl
          uv run --no-sync python -c "import [[ package_name ]]; print(f'[[ project_name ]] {[[ package_name ]].__version__} OK')"

  publish-testpypi:
    runs-on: ubuntu-latest
    needs: test-install
    environment: testpypi
    steps:
      - uses: actions/download-artifact@v8
        with:
          name: dist
          path: dist/
      - uses: pypa/gh-action-pypi-publish@release/v1
        with:
          repository-url: https://test.pypi.org/legacy/

  publish-pypi:
    runs-on: ubuntu-latest
    # Ordered *after* the TestPyPI rehearsal so its outcome is visible first, but
    # deliberately not gated on it. A TestPyPI-only fault — a missing trusted
    # publisher, an index outage — must not silently withhold the real release:
    # that failure mode shipped argus-proof images for two tags with no wheel on
    # PyPI, and nothing surfaced it because publish-image is independent.
    # Only the build + install gate is required; a TestPyPI failure still marks
    # the whole run failed, so the problem stays loud.
    needs: [test-install, publish-testpypi]
    if: "!cancelled() && needs.test-install.result == 'success'"
    environment: pypi
    steps:
      - uses: actions/download-artifact@v8
        with:
          name: dist
          path: dist/
      - uses: pypa/gh-action-pypi-publish@release/v1

  github-release:
    # Last, so a Release only appears once the version is on PyPI. Its notes are this
    # version's CHANGELOG.md section; a tag without one fails here rather than
    # publishing an empty Release (argus-echo v0.1.0 had no job and got no Release).
    # Skipped on a cortex dispatch, with the PyPI jobs it chains off.
    runs-on: ubuntu-latest
    needs: publish-pypi
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v7
      - uses: actions/download-artifact@v8
        with:
          name: dist
          path: dist/
      - name: Extract release notes from CHANGELOG.md
        run: |
          version="${GITHUB_REF_NAME#v}"
          awk -v head="## [${version}]" 'index($0, head) == 1 {found = 1; next} found && /^## \[/ {exit} found' \
            CHANGELOG.md > notes.md
          if ! grep -q '[^[:space:]]' notes.md; then
            echo "::error::CHANGELOG.md has no section for ${version}"
            exit 1
          fi
      - name: Create or update the GitHub Release
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          tag="${GITHUB_REF_NAME}"
          prerelease=""
          case "$tag" in *-*|*rc*|*a[0-9]*|*b[0-9]*) prerelease="--prerelease" ;; esac
          if gh release view "$tag" >/dev/null 2>&1; then
            # A re-run, or a Release made by hand: refresh its notes and assets rather than failing.
            gh release edit "$tag" --notes-file notes.md
            gh release upload "$tag" dist/* --clobber
          else
            gh release create "$tag" dist/* --verify-tag --title "$tag" --notes-file notes.md $prerelease
          fi

  release-tag:
    # The tag the image jobs build: the pushed one, or on a cortex dispatch the
    # newest final release. A pre-release never moved `latest`, so a dispatch
    # does not rebuild one.
    runs-on: ubuntu-latest
    outputs:
      tag: ${{ steps.tag.outputs.tag }}
      sha: ${{ steps.tag.outputs.sha }}
    steps:
      - uses: actions/checkout@v7
        if: github.event_name == 'repository_dispatch'
      - id: tag
        env:
          CORTEX_VERSION: ${{ github.event.client_payload.version }}
        run: |
          if [ "$GITHUB_EVENT_NAME" != repository_dispatch ]; then
            echo "tag=$GITHUB_REF_NAME" >> "$GITHUB_OUTPUT"
            echo "sha=$GITHUB_SHA" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          refs=$(git ls-remote --tags origin 'refs/tags/v*')
          tag=$(echo "$refs" | sed -n 's|.*refs/tags/\(v[0-9]*\.[0-9]*\.[0-9]*\)\(\^{}\)\{0,1\}$|\1|p' | sort -uV | tail -n1)
          if [ -z "$tag" ]; then
            echo "::notice::No release tag yet, so no image to rebuild for cortex $CORTEX_VERSION."
            exit 0
          fi
          # An annotated tag lists its commit on the peeled ^{} line.
          sha=$(echo "$refs" | awk -v t="refs/tags/$tag" '$2 == t {l = $1} $2 == t "^{}" {p = $1} END {print p ? p : l}')
          echo "Rebuilding $tag ($sha) for cortex $CORTEX_VERSION."
          echo "tag=$tag" >> "$GITHUB_OUTPUT"
          echo "sha=$sha" >> "$GITHUB_OUTPUT"

  publish-image:
    runs-on: ubuntu-latest
    needs: [release-tag, test-install]
    # On a cortex dispatch test-install is skipped (nothing was built for PyPI),
    # so the job runs on the tag alone.
    if: "!cancelled() && needs.release-tag.outputs.tag != '' && (needs.test-install.result == 'success' || github.event_name == 'repository_dispatch')"
[% if gpu_variant %]    # The CPU image keeps its tags; the CUDA build (Dockerfile GPU=1) is the same
    # tags with "-gpu" (0.1.0-gpu, 0.1-gpu, latest-gpu). Neither variant cancels
    # the other: each is checked and pushed on its own.
    strategy:
      fail-fast: false
      matrix:
        include:
          - gpu: "0"
            suffix: ""
          - gpu: "1"
            suffix: "-gpu"
[% endif %]    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@v7
        with:
          ref: ${{ needs.release-tag.outputs.tag }}
          fetch-depth: [[ 1 if version_build_arg else 0 ]] # hatch-vcs reads the tag from git history
      - uses: docker/setup-buildx-action@v4
      - uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - id: meta
        uses: docker/metadata-action@v6
        with:
          images: ghcr.io/${{ github.repository_owner }}/[[ image_name ]]
[% if gpu_variant %]          flavor: |
            suffix=${{ matrix.suffix }},onlatest=true
[% endif %]          labels: org.opencontainers.image.revision=${{ needs.release-tag.outputs.sha }}
          tags: |
            type=semver,pattern={{version}},value=${{ needs.release-tag.outputs.tag }}
            type=semver,pattern={{major}}.{{minor}},value=${{ needs.release-tag.outputs.tag }}
            # Only a final release moves `latest`. The trigger is `v*`, so without
            # this guard a `v0.2.0-rc1` tag would repoint every `:latest` user at a
            # candidate (tests/test_image_version.py checks it).
            type=raw,value=latest,enable=${{ !contains(needs.release-tag.outputs.tag, '-') }}
[% if gpu_variant %]      # The package version, from the tag: meta's version carries the "-gpu" suffix.
      - id: ver
        env:
          TAG: ${{ needs.release-tag.outputs.tag }}
        run: echo "version=${TAG#v}" >> "$GITHUB_OUTPUT"
[% endif %]      - uses: docker/build-push-action@v7
        with:
          context: .
          file: ./[[ dockerfile ]]
          # Loaded locally, not pushed: the version check below gates the push.
          load: true
          # The version the image reports comes from the tag, not from git inside
          # the build (argus-scout v0.1.0 shipped reporting 0.1.1.dev0+g<sha>.d<date>).
          build-args: |
[% if gpu_variant %]            VERSION=${{ steps.ver.outputs.version }}
            GPU=${{ matrix.gpu }}
[% else %]            VERSION=${{ steps.meta.outputs.version }}
[% endif %]          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          # A dispatch rebuilds an unchanged context, so a cached install layer
          # would keep the old argus-cortex.
          no-cache: ${{ github.event_name == 'repository_dispatch' }}
[% if gpu_variant %]          cache-from: type=gha,scope=image${{ matrix.suffix }}
          cache-to: type=gha,mode=max,scope=image${{ matrix.suffix }}
[% else %]          cache-from: type=gha
          cache-to: type=gha,mode=max
[% endif %]      - name: The image reports the tag's version
        id: version-check
        # Compared as PEP 440 versions: a v0.3.0-rc1 tag reports 0.3.0rc1.
        env:
          IMAGE: ${{ fromJSON(steps.meta.outputs.json).tags[0] }}
          WANT: ${{ steps.[[ 'ver' if gpu_variant else 'meta' ]].outputs.version }}
        run: |
          docker run --rm -i -e WANT "$IMAGE" python - <<'PY'
          import os
          import sys

          from pip._vendor.packaging.version import Version

          import [[ package_name ]]

          got, want = [[ package_name ]].__version__, os.environ["WANT"]
          print(f"image reports {got}, tag is {want}")
          if Version(got) != Version(want):
              print(f"::error::The image reports {got}, not {want}")
              sys.exit(1)
          PY
      - name: Push the checked image
        env:
          TAGS: ${{ steps.meta.outputs.tags }}
        run: |
          for tag in $TAGS; do
            docker push "$tag"
          done
