name: Docs

# Published docs (README.md + docs/**/*.md) are imported by the demo UIs at dev
# HEAD, so check them on every push to dev as well as on tags.[% if has_cli %]
# docs/cli.md is generated: regenerate it with `make docs` after changing the CLI.[% endif %]

on:
  push:
    branches: [dev, main]
    tags: ["v*"]
  pull_request:
    branches: [dev, main]

permissions:
  contents: read

jobs:
  docs:
    uses: [[ github_owner ]]/argus-ci/.github/workflows/docs-check.yml@v1
[% if has_cli %]    with:
      cli-module: [[ package_name ]].cli
      cli-name: [[ cli_name ]]
      install-extras: cli
[% endif %]    secrets:
      denylist: ${{ secrets.DOCS_DENYLIST }} # optional; unset = no private terms
