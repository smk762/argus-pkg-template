name: CI

on:
  push:
    branches: [dev, main]
  pull_request:
    branches: [dev, main]

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  ci:
    uses: [[ github_owner ]]/argus-ci/.github/workflows/python-ci.yml@v1
    with:
[% if ruff_pin %]      ruff-version: "[[ ruff_pin ]]"
[% endif %]      test-extras: "[[ test_extras ]]"
[% if post_test %]      post-test: "[[ post_test ]]"
[% endif %]
  suite-rules:
    # argus-ci suite rules: lint rules that each eliminate a finding class. New violations fail;
    # existing ones are in .suite-rules-baseline.json, which may only shrink.
    uses: [[ github_owner ]]/argus-ci/.github/workflows/suite-rules.yml@v1
