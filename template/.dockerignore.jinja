[% if version_build_arg %]# The version comes in as a build-arg and the image has no git, so .git is not needed.
.git
[% else %]# NOTE: .git is deliberately *not* ignored -- hatch-vcs reads the version from
# git history when a build passes no VERSION build-arg (a local `docker build .`).
[% endif %]# Never list a path git tracks here (.github, docs, ...): git inside the build sees it
# deleted, calls the tree dirty and versions the image X.Y.(Z+1).dev0+g<sha>.d<date>.
# tests/test_image_version.py checks this.
.venv
venv
dist
build
*.egg-info
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
