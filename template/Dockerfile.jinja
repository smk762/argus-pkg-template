# syntax=docker/dockerfile:1
FROM python:[[ python_min ]]-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# hatch-vcs derives the version from git history, so the build context must
# include .git (keep it out of .dockerignore for this image).
COPY . .

RUN uv pip install --system --no-cache "[[ '.[server]' if has_server else '.' ]]"

[% if has_server %]EXPOSE 8000
CMD ["uvicorn", "[[ package_name ]].server.app:app", "--host", "0.0.0.0", "--port", "8000"]
[% else %]CMD ["python", "-c", "import [[ package_name ]]; print([[ package_name ]].__version__)"]
[% endif %]
