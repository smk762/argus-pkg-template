# syntax=docker/dockerfile:1
FROM python:[[ python_min ]]-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

[% if version_build_arg %]# This image has neither .git in its build context nor a git binary, so the
# version always comes from the VERSION build-arg (the release passes the tag).
# A bare local `docker build .` falls back to 0.0.0.dev0.
[% else %]# hatch-vcs derives the version from git history when no VERSION build-arg is
# given (a local `docker build .`), so the build context must include .git (keep
# it out of .dockerignore) and the image must have the git binary --
# python:*-slim does not ship one, and without it the install below fails with
# "unable to detect version". Nothing tracked may be left out of the context
# either: git would see it deleted, call the tree dirty and version the image
# X.Y.(Z+1).dev0+g<sha>.d<date> on the vX.Y.Z tag.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
[% endif %]
COPY . .

# The release passes the tag (without the v) as VERSION, so the image reports it
# whatever git makes of the tree. SETUPTOOLS_SCM_PRETEND_VERSION is set only in
# the subshell that builds this package's wheel: as an ENV it would persist in
# the image and also version any dependency built from source. It must be the
# plain spelling -- hatch-vcs passes no dist name to setuptools-scm, so
# SETUPTOOLS_SCM_PRETEND_VERSION_FOR_<DIST> is ignored.
# tests/test_image_version.py keeps this wired to the release workflow.
ARG VERSION=""
[% if gpu_variant %]# GPU=1 builds the CUDA image (the release publishes it as <tag>-gpu): the
# package's [gpu] extra instead of [cpu], so pyproject.toml declares both. For
# ONNX Runtime they are onnxruntime-gpu and onnxruntime, which share one module
# directory, so exactly one may be installed. The CUDA and cuDNN runtimes can
# come as NVIDIA's pip wheels (onnxruntime-gpu[cuda,cudnn]) so the base stays
# python-slim. Running it needs the NVIDIA container runtime. The default (0)
# is the CPU image.
ARG GPU=0
[% endif %]RUN ([% if version_build_arg %]export SETUPTOOLS_SCM_PRETEND_VERSION="${VERSION:-0.0.0.dev0}"[% else %]if [ -n "$VERSION" ]; then export SETUPTOOLS_SCM_PRETEND_VERSION="$VERSION"; fi[% endif %] \
        && uv build --wheel --out-dir /tmp/dist) \
[% if gpu_variant %]    && if [ "$GPU" = "1" ]; then extra=gpu; else extra=cpu; fi \
    && uv pip install --system --no-cache "$(ls /tmp/dist/*.whl)[[ '[server,${extra}]' if has_server else '[${extra}]' ]]" \
[% else %]    && uv pip install --system --no-cache "$(ls /tmp/dist/*.whl)[[ '[server]' if has_server else '' ]]" \
[% endif %]    && rm -rf /tmp/dist

[% if has_server %]EXPOSE 8000
CMD ["uvicorn", "[[ package_name ]].server.app:app", "--host", "0.0.0.0", "--port", "8000"]
[% else %]CMD ["python", "-c", "import [[ package_name ]]; print([[ package_name ]].__version__)"]
[% endif %]
